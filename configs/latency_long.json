{
  "_comment": "Decode scaling over a long generation (benchmark_plan.md experiment 5): 1024 tokens with --ignore-eos at 8k and 32k for E0, E2, E4; decode_step_ms gives the per-step curve.",
  "model": {
    "path": "models/Llama-3.2-3B-Instruct-Q8_0.gguf",
    "tokenizer": "models/Llama-3.2-3B-Instruct-tokenizer",
    "runner": "./build/runner"
  },
  "latency": {
    "task": "niah_single_2",
    "lengths": [
      8192,
      32768
    ],
    "prompts": 1,
    "repeats": 2,
    "max_tokens": 1024,
    "configs": [
      {
        "name": "E0_full",
        "mode": "off"
      },
      {
        "name": "E2_s1_metal",
        "mode": "stage1",
        "stage1_backend": "metal"
      },
      {
        "name": "E4_hsa_metal",
        "mode": "hsa",
        "stage1_backend": "metal",
        "stage2_backend": "metal"
      }
    ]
  },
  "attention": {
    "budget": 1024,
    "window_size": 32,
    "kernel_size": 63
  },
  "management": {
    "data_dir": "data"
  }
}
