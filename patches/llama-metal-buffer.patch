diff --git a/ggml/include/ggml-metal.h b/ggml/include/ggml-metal.h
index 433838f..8bb8ce1 100644
--- a/ggml/include/ggml-metal.h
+++ b/ggml/include/ggml-metal.h
@@ -56,6 +56,11 @@ GGML_BACKEND_API void ggml_backend_metal_capture_next_compute(ggml_backend_t bac
 
 GGML_BACKEND_API ggml_backend_reg_t ggml_backend_metal_reg(void);
 
+// Optional proc address: "ggml_backend_metal_get_tensor_buffer".
+// Returns a borrowed shared MTLBuffer and byte offset, or false for unsupported tensors.
+// The caller must synchronize producers and keep the tensor's backend buffer alive until GPU work completes.
+typedef bool (*ggml_backend_metal_get_tensor_buffer_t)(const struct ggml_tensor * tensor, void ** buffer, size_t * offset);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/ggml/src/ggml-metal/ggml-metal.cpp b/ggml/src/ggml-metal/ggml-metal.cpp
index d0771eb..e51b3e8 100644
--- a/ggml/src/ggml-metal/ggml-metal.cpp
+++ b/ggml/src/ggml-metal/ggml-metal.cpp
@@ -183,6 +183,29 @@ static bool ggml_backend_buffer_is_metal(ggml_backend_buffer_t buffer) {
            buffer->iface.free_buffer == ggml_backend_metal_buffer_private_free_buffer;
 }
 
+static bool ggml_backend_metal_get_tensor_buffer(const ggml_tensor * tensor, void ** buffer, size_t * offset) {
+    if (!buffer || !offset) {
+        return false;
+    }
+    *buffer = nullptr;
+    *offset = 0;
+    if (!tensor || !tensor->data) {
+        return false;
+    }
+    ggml_backend_buffer_t backing = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (!backing || !ggml_backend_buffer_is_metal(backing)) {
+        return false;
+    }
+    auto ctx = (ggml_metal_buffer_t) backing->context;
+    if (!ggml_metal_buffer_is_shared(ctx)) {
+        return false;
+    }
+    const auto bid = ggml_metal_buffer_get_id(ctx, tensor);
+    *buffer = bid.metal;
+    *offset = bid.offs;
+    return bid.metal != nullptr;
+}
+
 //
 // buffer types
 //
@@ -946,6 +969,9 @@ static void ggml_backend_metal_fusion_set_enabled(ggml_backend_fusion_t finfo, b
 }
 
 static void * ggml_backend_metal_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    if (strcmp(name, "ggml_backend_metal_get_tensor_buffer") == 0) {
+        return (void *) ggml_backend_metal_get_tensor_buffer;
+    }
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_metal_get_features;
     }
