     return cparams.causal_attn;
 }
 
+bool llama_context::set_rocket_attention(llama_rocket_attention_builder builder, void * user_data) {
+    synchronize();
+    if (builder) {
+        const auto * kv = dynamic_cast<const llama_kv_cache *>(memory.get());
+        const auto & hp = model.hparams;
+        if (model.arch != LLM_ARCH_LLAMA || !kv || cparams.n_seq_max != 1 ||
+                !cparams.causal_attn || cparams.training || cparams.pipeline_parallel ||
+                hp.swa_type != LLAMA_SWA_TYPE_NONE || hp.attn_soft_cap || hp.f_max_alibi_bias != 0.0f ||
+                kv->type_k() != GGML_TYPE_F16 || kv->type_v() != GGML_TYPE_F16 || kv->get_n_stream() != 1) {
+            LLAMA_LOG_ERROR("%s: requires single-sequence Llama causal attention with F16 KV\n", __func__);
+            return false;
+        }
+        for (uint32_t il = 0; il < hp.n_layer(); ++il) {
+            if (hp.n_head_kv(il) == 0 || hp.n_head(il) % hp.n_head_kv(il) != 0 ||
+                    hp.n_embd_head_k(il) != hp.n_embd_head_v(il)) {
+                LLAMA_LOG_ERROR("%s: unsupported head dimensions\n", __func__);
+                return false;
+            }
+        }
+    }
+    cparams.rocket_attention = builder;
+    cparams.rocket_user_data = user_data;
+    return true;
+}
+
+void llama_context::set_rocket_f32_reference(bool enabled) {
+    synchronize();
+    cparams.rocket_f32_reference = enabled;
+}
+
 void llama_context::set_warmup(bool value) {
     LLAMA_LOG_DEBUG("%s: value = %d\n", __func__, value);
 
@@ -1841,6 +1872,10 @@ static bool needs_raw_logits(const llama_ubatch & ubatch, const std::map<llama_s
 }
 
 int llama_context::decode(const llama_batch_ext & batch_inp) {
+    if (cparams.rocket_attention && batch_inp.tokens.size() != 1) {
+        LLAMA_LOG_ERROR("%s: Rocket decode requires exactly one token\n", __func__);
+        return -1;
+    }
     if (!memory) {
         LLAMA_LOG_DEBUG("%s: cannot decode batches with this context (calling encode() instead)\n", __func__);
         return encode(batch_inp);
@@ -4226,6 +4261,39 @@ void llama_set_causal_attn(llama_context * ctx, bool causal_attn) {
     ctx->set_causal_attn(causal_attn);
 }
 
+int32_t llama_rocket_abi_version(void) {
+    return LLAMA_ROCKET_ABI_VERSION;
+}
+
+void llama_rocket_set_f32_reference(llama_context * ctx, bool enabled) {
+    ctx->set_rocket_f32_reference(enabled);
+}
+
+bool llama_set_rocket_attention(llama_context * ctx, llama_rocket_attention_builder builder, void * user_data) {
+    return ctx && ctx->set_rocket_attention(builder, user_data);
+}
+
+int32_t llama_rocket_kv_positions(const llama_context * ctx, llama_pos * positions, size_t capacity) {
+    if (!ctx || ctx->n_seq_max() != 1) {
+        return -1;
+    }
+    const auto * kv = dynamic_cast<const llama_kv_cache *>(ctx->get_memory());
+    if (!kv || kv->get_n_stream() != 1) {
+        return -1;
+    }
+    const auto & cells = kv->get_cells(0);
+    if (!positions) {
+        return cells.size();
+    }
+    if (capacity > cells.size()) {
+        return -1;
+    }
+    for (size_t i = 0; i < capacity; ++i) {
+        positions[i] = cells.is_empty(i) || !cells.seq_has(i, 0) ? -1 : cells.pos_get(i);
+    }
+    return capacity;
+}
+
 bool llama_get_causal_attn(const llama_context * ctx) {
     return ctx->get_causal_attn();
 }
