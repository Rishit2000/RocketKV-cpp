diff --git a/include/llama-rocket.h b/include/llama-rocket.h
new file mode 100644
index 0000000..fedfab8
--- /dev/null
+++ b/include/llama-rocket.h
@@ -0,0 +1,45 @@
+#ifndef LLAMA_ROCKET_H
+#define LLAMA_ROCKET_H
+
+#include "llama.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LLAMA_ROCKET_ABI_VERSION 1
+
+// Q: [D, 1, Hq, 1], K/V: [D, slots, Hkv, 1]. Return F32 [D, Hq, 1, 1].
+typedef struct ggml_tensor * (*llama_rocket_attention_builder)(
+        struct ggml_context * graph_ctx,
+        struct ggml_tensor * q,
+        struct ggml_tensor * k,
+        struct ggml_tensor * v,
+        struct ggml_tensor * mask,
+        float scale,
+        int32_t layer,
+        void * user_data);
+
+LLAMA_API int32_t llama_rocket_abi_version(void);
+
+// Diagnostic native matmul/softmax path with F32 operands and accumulation.
+LLAMA_API void llama_rocket_set_f32_reference(struct llama_context * ctx, bool enabled);
+
+// NULL restores native attention. The caller owns user_data until all work completes.
+LLAMA_API bool llama_set_rocket_attention(
+        struct llama_context * ctx,
+        llama_rocket_attention_builder builder,
+        void * user_data);
+
+// Sequence 0 only. NULL returns slot capacity; otherwise copy the requested prefix.
+// No synchronization: use after synchronize(), or inside the single-sequence CPU node.
+LLAMA_API int32_t llama_rocket_kv_positions(
+        const struct llama_context * ctx,
+        llama_pos * positions,
+        size_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
