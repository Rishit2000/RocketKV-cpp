+static bool ggml_backend_metal_set_custom(ggml_tensor * tensor, ggml_backend_metal_custom_encode_t encode, void * userdata) {
+    static_assert(sizeof(ggml_custom_op_params) <= GGML_METAL_CUSTOM_OFFSET, "CUSTOM parameters overlap");
+    if (!tensor || tensor->op != GGML_OP_CUSTOM || !encode) return false;
+    const ggml_metal_custom_params params = {GGML_METAL_CUSTOM_TAG, encode, userdata};
+    memcpy((char *) tensor->op_params + GGML_METAL_CUSTOM_OFFSET, &params, sizeof(params));
+    return true;
+}
