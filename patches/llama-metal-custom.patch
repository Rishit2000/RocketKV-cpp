 #ifdef __cplusplus
 extern "C" {
 #endif
 
+struct ggml_metal_custom_params {
+    uint64_t tag;
+    ggml_backend_metal_custom_encode_t encode;
+    void * userdata;
+};
+#define GGML_METAL_CUSTOM_TAG UINT64_C(0x524f434b4d544c31)
+#define GGML_METAL_CUSTOM_OFFSET (GGML_MAX_OP_PARAMS - sizeof(struct ggml_metal_custom_params))
+
+static inline struct ggml_metal_custom_params ggml_metal_get_custom(const struct ggml_tensor * tensor) {
+    struct ggml_metal_custom_params params = {0};
+    if (tensor->op == GGML_OP_CUSTOM) {
+        memcpy(&params, (const char *) tensor->op_params + GGML_METAL_CUSTOM_OFFSET, sizeof(params));
+        if (params.tag != GGML_METAL_CUSTOM_TAG) params.encode = NULL;
+    }
+    return params;
+}
